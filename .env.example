# Invalid examples only. Copy outside the repository; never commit real values.
# The same private config is loaded by all three components.
STBRAIN_MCP_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_MCP_TOKEN
STBRAIN_WAKE_SECRET=REPLACE_WITH_UNIQUE_RANDOM_WAKE_SECRET
STBRAIN_HOST_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_HOST_TOKEN
STBRAIN_HUMAN_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_HUMAN_TOKEN
STBRAIN_GATEWAY_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_GATEWAY_TOKEN
STBRAIN_MODEL_ID=model:example-assistant
STBRAIN_OWNER_ID=ai:example-assistant
STBRAIN_HUMAN_ACTOR_ID=human:example-owner
STBRAIN_DB_PATH=/absolute/private/stiller-data/self-model.db
STBRAIN_LEARNING_IDEA_DB_PATH=/absolute/private/stiller-data/learning-ideas.db
STBRAIN_HALLUCINATION_VAULT_DB_PATH=/absolute/private/stiller-data/hallucination-vault.db
STBRAIN_REQUIRE_EXECUTION_BINDING=1
STBRAIN_EXECUTION_EPOCH=REPLACE_WITH_SHARED_DEPLOYMENT_UUID
# Recommended for new installations. Omit or use legacy to retain older rules.
# Ordinary modules are read-only until module one is first set up and activated.
STBRAIN_ACCESS_PROFILE=simple-memory-v1
# Optional: needed for official/direct clients to authorize module-one changes.
# Gateway-authorized self changes and ordinary writes do not require this password.
# Create it offline with scripts/configure_self_password.py --output ABSOLUTE_PATH.
# Use an existing private directory outside this repository, then set its full path.
# Example: /absolute/private/stiller-data/self-password.json
STBRAIN_SELF_PASSWORD_HASH_FILE=
STBRAIN_MCP_HOST=127.0.0.1
STBRAIN_MCP_PORT=18794
STBRAIN_MCP_ISSUER_URL=http://127.0.0.1:18794
STBRAIN_MCP_RESOURCE_URL=http://127.0.0.1:18794/mcp
STBRAIN_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
STBRAIN_MCP_ALLOWED_ORIGINS=
STBRAIN_CONTROL_HOST=127.0.0.1
STBRAIN_CONTROL_PORT=18795
STBRAIN_CONTROL_URL=http://127.0.0.1:18795
STBRAIN_GATEWAY_HOST=127.0.0.1
STBRAIN_GATEWAY_PORT=18796
STBRAIN_GATEWAY_HOST_ID=stiller-local-gateway
STBRAIN_GATEWAY_CONTRACT=rikkahub-openai-gateway/2
# Stable ST context, actual client messages, then this wake's dynamic ST context.
# An older config without this setting retains legacy layout; anchored-v1 is also supported.
# Continue a tool chain with its original messages and tool schemas unchanged.
STBRAIN_GATEWAY_CONTEXT_LAYOUT=tail-context-v2
STBRAIN_UPSTREAM_BASE_URL=https://provider.example/v1
STBRAIN_UPSTREAM_API_KEY=REPLACE_WITH_PROVIDER_KEY
STBRAIN_GATEWAY_MODEL=REPLACE_WITH_PUBLIC_MODEL_ID
STBRAIN_UPSTREAM_MODEL=REPLACE_WITH_UPSTREAM_MODEL_ID
