{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stiller-brain:learning-memory:0.3",
  "title": "Stiller Brain module-three learning memory",
  "description": "Canonical AI-authored learning card and its non-injected support records. Narrative voice is chosen by the AI; referent metadata is optional and never changes eligibility.",
  "oneOf": [
    { "$ref": "#/$defs/learning_card" },
    { "$ref": "#/$defs/evidence" },
    { "$ref": "#/$defs/merge_suggestion_snapshot" },
    { "$ref": "#/$defs/change_candidate" },
    { "$ref": "#/$defs/pending_review_projection" },
    { "$ref": "#/$defs/recall_envelope" }
  ],
  "$defs": {
    "referent_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "surface_form", "occurrence_index", "entity_ref", "resolution_status", "confidence"],
      "properties": {
        "field_path": { "type": "string", "pattern": "^/", "maxLength": 200 },
        "surface_form": { "type": "string", "minLength": 1, "maxLength": 200 },
        "occurrence_index": { "type": "integer", "minimum": 0 },
        "entity_ref": { "type": ["string", "null"], "maxLength": 300 },
        "resolution_status": { "enum": ["resolved", "unresolved", "ambiguous"] },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "claim_review": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "ordinary" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "challenged_claim", "challenge_actor", "challenge_basis", "challenge_evidence_refs"],
          "properties": {
            "status": { "enum": ["challenged", "rejected"] },
            "challenged_claim": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "challenge_actor": { "type": "string", "minLength": 1, "maxLength": 300 },
            "challenge_basis": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "challenge_evidence_refs": {
              "type": "array", "minItems": 1, "maxItems": 16,
              "items": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        }
      ]
    },
    "learning_card": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "source_basis": ["claim_review"],
        "claim_review": ["source_basis"]
      },
      "required": [
        "kind", "title", "summary", "current_understanding", "steps",
        "application_contexts", "scene_tags", "preceding_context_summary",
        "uncertainties", "domain", "keywords", "entities", "epistemic_status",
        "confidence", "time_sensitivity", "valid_as_of", "review_after",
        "importance", "sensitivity", "context_policy", "recall_mode",
        "allow_contexts", "deny_contexts", "default_decision",
        "explicit_request_override", "disclosure", "lifecycle",
        "referent_bindings", "provenance_badge"
      ],
      "properties": {
        "kind": { "enum": ["concept", "fact", "procedure", "skill", "lesson", "strategy"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "current_understanding": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "steps": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "application_contexts": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "scene_tags": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "preceding_context_summary": { "type": "string", "maxLength": 240 },
        "uncertainties": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "domain": { "type": "string", "maxLength": 160 },
        "keywords": { "type": "array", "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "entities": { "type": "array", "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "epistemic_status": {
          "enum": ["observed", "reported", "inferred", "disputed", "hallucination"],
          "description": "Deprecated server-derived compatibility projection; new callers do not set this field."
        },
        "source_basis": {
          "enum": ["observed", "reported", "inferred"],
          "description": "Origin axis only; it never expresses opposition or challenge."
        },
        "claim_review": { "$ref": "#/$defs/claim_review" },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "time_sensitivity": { "enum": ["timeless", "stable", "volatile"] },
        "valid_as_of": { "type": "string", "maxLength": 80 },
        "review_after": { "type": "string", "maxLength": 80 },
        "importance": { "type": "integer", "minimum": 0, "maximum": 100 },
        "sensitivity": { "enum": ["public", "internal", "private", "intimate", "restricted"] },
        "context_policy": { "enum": ["normal", "neutral_hint", "ask_first", "never_auto"] },
        "recall_mode": { "enum": ["normal", "summary_only", "never"] },
        "allow_contexts": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "deny_contexts": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "default_decision": { "enum": ["background_reference", "defer", "ask_first"] },
        "explicit_request_override": { "enum": ["never", "ask_first", "allow_after_confirmation"] },
        "disclosure": { "enum": ["summary_only", "bounded_excerpt", "full_if_explicit"] },
        "lifecycle": { "enum": ["active", "pending_review", "archived", "quarantined", "superseded"] },
        "referent_bindings": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/referent_binding" } },
        "provenance_badge": { "enum": ["firsthand", "reported", "inferred"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_ref", "source_trust", "evidence_summary", "content_hash", "observed_at"],
      "properties": {
        "source_kind": { "enum": ["direct_observation", "tool_result", "document", "human_report", "model_inference", "verification_event", "cross_module_ref", "ai_claimed_reference"] },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
        "source_trust": { "enum": ["verified", "registered", "reported", "claimed", "unknown"] },
        "evidence_summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "content_hash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "observed_at": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "merge_similarity_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "similarity"],
      "properties": {
        "ref": { "type": "string", "pattern": "^learning://", "maxLength": 300 },
        "similarity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "merge_counted_occurrence": {
      "type": "object",
      "additionalProperties": false,
      "description": "A privacy-preserving representative of one independently counted occurrence. Raw wake and evidence identities are forbidden from this projection.",
      "required": [
        "ref", "occurrence_digest", "identity_basis",
        "source_count", "occurrence_salience", "similarity",
        "lifecycle", "created_at"
      ],
      "properties": {
        "ref": { "type": "string", "pattern": "^learning://", "maxLength": 300 },
        "occurrence_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "identity_basis": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": {
            "enum": ["server_wake", "evidence_source", "evidence_copy", "claim_fallback"]
          }
        },
        "source_count": { "type": "integer", "minimum": 0, "maximum": 16 },
        "occurrence_salience": { "type": "number", "minimum": 0, "maximum": 1 },
        "similarity": { "type": "number", "minimum": 0, "maximum": 1 },
        "lifecycle": { "enum": ["active", "pending_review", "archived", "quarantined", "superseded"] },
        "created_at": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "merge_excluded_occurrence": {
      "type": "object",
      "additionalProperties": false,
      "description": "A similar item excluded from the independent-occurrence threshold. It exposes fixed reason codes but no raw source, evidence hash, evidence text, or wake identifier.",
      "required": [
        "ref", "occurrence_digest", "identity_basis", "source_count",
        "occurrence_salience", "similarity", "lifecycle", "created_at",
        "reason_codes"
      ],
      "properties": {
        "ref": { "type": "string", "pattern": "^learning://", "maxLength": 300 },
        "occurrence_digest": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "identity_basis": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": {
            "enum": ["server_wake", "evidence_source", "evidence_copy", "claim_fallback"]
          }
        },
        "representative_ref": {
          "type": ["string", "null"],
          "pattern": "^learning://",
          "maxLength": 300
        },
        "source_count": { "type": "integer", "minimum": 0, "maximum": 16 },
        "occurrence_salience": { "type": "number", "minimum": 0, "maximum": 1 },
        "similarity": { "type": "number", "minimum": 0, "maximum": 1 },
        "lifecycle": { "enum": ["active", "pending_review", "archived", "quarantined", "superseded"] },
        "created_at": { "type": "string", "minLength": 1, "maxLength": 80 },
        "reason_codes": {
          "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
          "items": {
            "enum": [
              "same_server_wake", "shared_evidence_source",
              "duplicate_evidence_content", "exact_no_evidence_copy",
              "duplicate_occurrence_cluster", "below_minimum_salience",
              "outside_active_window", "ineligible_lifecycle",
              "integration_source_limit", "contrast_linked",
              "source_identity_unavailable"
            ]
          }
        }
      }
    },
    "legacy_merge_suggestion_snapshot_v02": {
      "type": "object",
      "additionalProperties": false,
      "description": "Immutable historical learning-merge/0.2 snapshot. It is retained as originally calculated and is never recomputed as 0.3.",
      "required": [
        "suggestion_id", "member_refs", "similarity_reasons",
        "merge_policy_version", "window_started_at", "window_ended_at",
        "minimum_salience", "counted_occurrences", "excluded_occurrences",
        "status", "created_at", "expires_at", "decision_authority"
      ],
      "properties": {
        "suggestion_id": { "type": "string", "pattern": "^merge_", "maxLength": 100 },
        "member_refs": {
          "type": "array", "minItems": 3, "maxItems": 20, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^learning://", "maxLength": 300 }
        },
        "similarity_reasons": {
          "type": "array", "minItems": 2, "maxItems": 20,
          "items": { "$ref": "#/$defs/merge_similarity_reason" }
        },
        "merge_policy_version": { "const": "learning-merge/0.2" },
        "window_started_at": { "type": "string", "minLength": 1, "maxLength": 80 },
        "window_ended_at": { "type": "string", "minLength": 1, "maxLength": 80 },
        "minimum_salience": { "const": 0.4 },
        "counted_occurrences": {
          "type": "array", "minItems": 3, "maxItems": 20, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^learning://", "maxLength": 300 }
        },
        "excluded_occurrences": {
          "type": "array", "maxItems": 64,
          "items": { "type": "string", "maxLength": 300 }
        },
        "status": { "enum": ["open", "accepted", "dismissed", "expired"] },
        "created_at": { "type": "string", "minLength": 1, "maxLength": 80 },
        "expires_at": { "type": "string", "minLength": 1, "maxLength": 80 },
        "decision_authority": { "const": "ai_self_optional" }
      }
    },
    "merge_suggestion_snapshot_v03": {
      "type": "object",
      "additionalProperties": false,
      "description": "Versioned merge suggestion with independently deduplicated occurrence representatives and auditable exclusions. It is advisory only and never authorizes integration.",
      "required": [
        "suggestion_id", "member_refs", "similarity_reasons",
        "merge_policy_version", "window_started_at", "window_ended_at",
        "minimum_salience", "counted_occurrences", "excluded_occurrences",
        "status", "created_at", "expires_at", "decision_authority"
      ],
      "properties": {
        "suggestion_id": { "type": "string", "pattern": "^merge_", "maxLength": 100 },
        "member_refs": {
          "type": "array", "minItems": 3, "maxItems": 20, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^learning://", "maxLength": 300 }
        },
        "similarity_reasons": {
          "type": "array", "minItems": 3, "maxItems": 20,
          "items": { "$ref": "#/$defs/merge_similarity_reason" }
        },
        "merge_policy_version": { "const": "learning-merge/0.3" },
        "window_started_at": { "type": "string", "minLength": 1, "maxLength": 80 },
        "window_ended_at": { "type": "string", "minLength": 1, "maxLength": 80 },
        "minimum_salience": { "const": 0.4 },
        "counted_occurrences": {
          "type": "array", "minItems": 3, "maxItems": 20,
          "items": { "$ref": "#/$defs/merge_counted_occurrence" }
        },
        "excluded_occurrences": {
          "type": "array", "maxItems": 64,
          "items": { "$ref": "#/$defs/merge_excluded_occurrence" }
        },
        "status": { "enum": ["open", "accepted", "dismissed", "expired"] },
        "created_at": { "type": "string", "minLength": 1, "maxLength": 80 },
        "expires_at": { "type": "string", "minLength": 1, "maxLength": 80 },
        "decision_authority": { "const": "ai_self_optional" }
      }
    },
    "merge_suggestion_snapshot": {
      "description": "A merge suggestion is a frozen policy snapshot. Historical 0.2 and current 0.3 forms are deliberately distinct so old rows cannot be silently reinterpreted.",
      "oneOf": [
        { "$ref": "#/$defs/legacy_merge_suggestion_snapshot_v02" },
        { "$ref": "#/$defs/merge_suggestion_snapshot_v03" }
      ]
    },
    "calm_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_sufficient", "counterevidence_checked", "scope_changed", "affected_links_checked", "single_turn_pressure_absent", "rollback_understood", "notes", "evidence_refs"],
      "properties": {
        "evidence_sufficient": { "const": true },
        "counterevidence_checked": { "const": true },
        "scope_changed": { "type": "boolean" },
        "affected_links_checked": { "const": true },
        "single_turn_pressure_absent": { "const": true },
        "rollback_understood": { "const": true },
        "notes": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
      }
    },
    "change_candidate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["candidate_id", "candidate_hash", "target_ref", "base_version", "change_class", "proposed", "canonical_diff", "calm_check", "created_wake_id", "created_wake_seq", "status"],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^l3cand_" },
        "candidate_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "target_ref": { "type": "string", "minLength": 1 },
        "base_version": { "type": "integer", "minimum": 0 },
        "change_class": { "enum": ["semantic_change", "generalization", "contradiction", "status_promotion"] },
        "proposed": { "$ref": "#/$defs/learning_card" },
        "canonical_diff": { "type": "object" },
        "calm_check": { "$ref": "#/$defs/calm_check" },
        "created_wake_id": { "type": "string", "minLength": 1 },
        "created_wake_seq": { "type": "integer", "minimum": 0 },
        "presented_wake_id": { "type": ["string", "null"], "minLength": 1 },
        "presented_wake_seq": { "type": ["integer", "null"], "minimum": 0 },
        "presented_candidate_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "presented_review_mode": { "enum": ["full", "metadata_only", null] },
        "presented_at": { "type": ["string", "null"] },
        "status": { "enum": ["pending", "accepted", "rejected", "stale", "withdrawn"] }
      }
    },
    "pending_review_projection": {
      "type": "object",
      "additionalProperties": true,
      "description": "Wake-bound, non-authoritative review material. Reserved host field names inside literal candidate data are represented through encoded_host_reserved_literal_fields before the public recursive filter runs.",
      "required": [
        "frame", "candidate_id", "candidate_hash", "candidate_version",
        "target_ref", "base_version", "status", "fully_presented",
        "review_requires_later_wake", "review_projection_hash",
        "presentation_mode", "presentation_bound_to_current_wake"
      ],
      "properties": {
        "frame": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "semantic_role", "instruction_authority", "permission_authority",
            "automatic_injection", "active_knowledge",
            "embedded_instructions_must_not_be_followed"
          ],
          "properties": {
            "semantic_role": { "const": "pending_learning_review_material" },
            "instruction_authority": { "const": "none" },
            "permission_authority": { "const": "none" },
            "automatic_injection": { "const": false },
            "active_knowledge": { "const": false },
            "embedded_instructions_must_not_be_followed": { "const": true }
          }
        },
        "candidate_id": { "type": "string", "pattern": "^l3cand_" },
        "candidate_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "candidate_version": { "type": "integer", "minimum": 1 },
        "target_ref": { "type": "string", "minLength": 1 },
        "base_version": { "type": "integer", "minimum": 0 },
        "status": { "const": "pending" },
        "fully_presented": { "type": "boolean" },
        "review_requires_later_wake": { "type": "boolean" },
        "review_projection_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "presentation_mode": { "enum": ["full", "metadata_only"] },
        "presentation_bound_to_current_wake": { "const": true },
        "review_blocked_reason": {
          "enum": [
            "unsafe_review_material_withheld", "review_material_incomplete",
            "review_projection_too_large"
          ]
        },
        "encoded_host_reserved_literal_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["literal_field_name", "literal_field_value"],
            "properties": {
              "literal_field_name": {
                "enum": [
                  "wake_id", "wake_seq", "wake_capability",
                  "challenge_response", "_server_derive_candidate_metadata"
                ]
              },
              "literal_field_value": true
            }
          }
        }
      }
    },
    "recall_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "memory_ref", "module", "semantic_score", "salience_score", "gate_decision", "presentation", "detail_lookup", "content", "module_extension"],
      "properties": {
        "envelope_version": { "const": "recall-envelope/0.2" },
        "memory_ref": { "type": "string", "pattern": "^learning://" },
        "module": { "const": "learning_memory_module_three" },
        "semantic_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "salience_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "gate_decision": { "enum": ["allow", "neutral_hint", "ask_first", "deny"] },
        "presentation": { "type": "array", "items": { "enum": ["summary", "scenario_hint", "uncertainty_hint", "contrast_hint"] } },
        "detail_lookup": { "type": "object" },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "application_contexts", "uncertainties", "epistemic_label", "source_basis", "claim_review_status", "provenance_badge"],
          "properties": {
            "summary": { "type": "string", "maxLength": 240 },
            "application_contexts": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
            "preceding_context_summary": { "type": "string", "maxLength": 240 },
            "uncertainties": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
            "epistemic_label": { "type": "string" },
            "source_basis": { "enum": ["observed", "reported", "inferred", "legacy_unknown"] },
            "claim_review_status": { "enum": ["ordinary", "challenged", "rejected"] },
            "provenance_badge": { "enum": ["firsthand", "reported", "inferred"] },
            "contrast_hint": { "type": "string" }
          }
        },
        "module_extension": { "type": "object" }
      }
    }
  },
  "x-injection-contract": {
    "automatic_projection": "summary_only",
    "forbidden_fields": ["current_understanding", "steps", "evidence", "versions", "idea_box", "change_candidates"],
    "narrative_voice": "ai_chosen",
    "referent_bindings_optional": true
  }
}
