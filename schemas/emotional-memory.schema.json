{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stiller-brain:emotional-memory:0.2.0",
  "title": "AI-authored Emotional Memory",
  "description": "A module-two memory with an author-revisable current body and append-only historical versions. Disclosure safeguards apply to every version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_type",
    "original_text",
    "summary",
    "primary_emotion",
    "origin",
    "confidence",
    "sensitivity",
    "context_policy"
  ],
  "properties": {
    "memory_type": {
      "enum": [
        "unclassified",
        "shared_event",
        "feeling",
        "relationship",
        "meaningful_dialogue",
        "emotional_reflection",
        "integration"
      ]
    },
    "original_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "AI-authored narration. The AI may choose first, second, third, or another grammatical-person style; grammar alone never determines authorship."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "AI-authored summary in the grammatical-person style selected by the AI."
    },
    "primary_emotion": {
      "enum": [
        "joy",
        "affection",
        "trust",
        "gratitude",
        "longing",
        "relief",
        "pride",
        "hope",
        "sadness",
        "fear",
        "anger",
        "hurt",
        "disappointment",
        "shame",
        "guilt",
        "loneliness",
        "tenderness",
        "concern",
        "surprise",
        "calm",
        "mixed",
        "other"
      ]
    },
    "secondary_emotions": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/emotion"
      }
    },
    "importance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 50
    },
    "origin": {
      "enum": [
        "firsthand",
        "reported",
        "inferred",
        "unmarked"
      ],
      "description": "firsthand=亲历；reported=转述；inferred=推断；unmarked=未标注。创建时省略采用 unmarked，修订时省略保留原值。"
    },
    "confidence": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "0–100 为作者评分；null 为未标注。创建时省略为 null；统一修订 changes.confidence=null 清除评分，省略保留原值。"
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "private",
        "intimate",
        "restricted"
      ]
    },
    "context_policy": {
      "enum": [
        "normal",
        "neutral_hint",
        "ask_first",
        "never_auto"
      ]
    },
    "keywords": {
      "$ref": "#/$defs/hints"
    },
    "entities": {
      "$ref": "#/$defs/hints"
    },
    "referent_bindings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/referentBinding"
      },
      "description": "Optional referent metadata. unresolved and ambiguous are valid non-blocking states and do not change memory confidence, ranking, or recall eligibility."
    },
    "recall_mode": {
      "enum": [
        "normal",
        "summary_only",
        "never"
      ],
      "default": "normal"
    },
    "allow_contexts": {
      "$ref": "#/$defs/contexts"
    },
    "deny_contexts": {
      "$ref": "#/$defs/contexts"
    },
    "default_decision": {
      "enum": [
        "background_reference",
        "defer",
        "ask_first"
      ],
      "default": "background_reference"
    },
    "explicit_request_override": {
      "enum": [
        "never",
        "ask_first",
        "allow_after_confirmation"
      ],
      "default": "allow_after_confirmation"
    },
    "disclosure": {
      "enum": [
        "summary_only",
        "bounded_excerpt",
        "full_if_explicit"
      ],
      "default": "bounded_excerpt"
    }
  },
  "$defs": {
    "emotion": {
      "enum": [
        "joy",
        "affection",
        "trust",
        "gratitude",
        "longing",
        "relief",
        "pride",
        "hope",
        "sadness",
        "fear",
        "anger",
        "hurt",
        "disappointment",
        "shame",
        "guilt",
        "loneliness",
        "tenderness",
        "concern",
        "surprise",
        "calm",
        "mixed",
        "other"
      ]
    },
    "hints": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "contexts": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "referentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_path",
        "surface_form",
        "occurrence_index",
        "resolution_status",
        "confidence"
      ],
      "properties": {
        "field_path": {
          "enum": [
            "/original_text",
            "/summary"
          ]
        },
        "surface_form": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "occurrence_index": {
          "type": "integer",
          "minimum": 0
        },
        "entity_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300
        },
        "resolution_status": {
          "enum": [
            "resolved",
            "unresolved",
            "ambiguous"
          ]
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "authoredChanges": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Only AI-authored fields. Technical identities, versions, hashes and execution permissions are not writable. Existing sensitivity/disclosure and quarantine checks still apply.",
      "properties": {
        "memory_type": {
          "enum": [
            "unclassified",
            "shared_event",
            "feeling",
            "relationship",
            "meaningful_dialogue",
            "emotional_reflection",
            "integration"
          ]
        },
        "original_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "AI-authored narration. The AI may choose first, second, third, or another grammatical-person style; grammar alone never determines authorship."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "AI-authored summary in the grammatical-person style selected by the AI."
        },
        "primary_emotion": {
          "enum": [
            "joy",
            "affection",
            "trust",
            "gratitude",
            "longing",
            "relief",
            "pride",
            "hope",
            "sadness",
            "fear",
            "anger",
            "hurt",
            "disappointment",
            "shame",
            "guilt",
            "loneliness",
            "tenderness",
            "concern",
            "surprise",
            "calm",
            "mixed",
            "other"
          ]
        },
        "secondary_emotions": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/emotion"
          }
        },
        "importance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 50
        },
        "origin": {
          "enum": [
            "firsthand",
            "reported",
            "inferred",
            "unmarked"
          ],
          "description": "firsthand=亲历；reported=转述；inferred=推断；unmarked=未标注。修订时省略保留原值。"
        },
        "confidence": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "0–100 为作者评分；null 清除评分并显示未标注；省略保留原值。"
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "private",
            "intimate",
            "restricted"
          ]
        },
        "context_policy": {
          "enum": [
            "normal",
            "neutral_hint",
            "ask_first",
            "never_auto"
          ]
        },
        "keywords": {
          "$ref": "#/$defs/hints"
        },
        "entities": {
          "$ref": "#/$defs/hints"
        },
        "referent_bindings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/referentBinding"
          },
          "description": "Optional referent metadata. unresolved and ambiguous are valid non-blocking states and do not change memory confidence, ranking, or recall eligibility."
        },
        "recall_mode": {
          "enum": [
            "normal",
            "summary_only",
            "never"
          ],
          "default": "normal"
        },
        "allow_contexts": {
          "$ref": "#/$defs/contexts"
        },
        "deny_contexts": {
          "$ref": "#/$defs/contexts"
        },
        "default_decision": {
          "enum": [
            "background_reference",
            "defer",
            "ask_first"
          ],
          "default": "background_reference"
        },
        "explicit_request_override": {
          "enum": [
            "never",
            "ask_first",
            "allow_after_confirmation"
          ],
          "default": "allow_after_confirmation"
        },
        "disclosure": {
          "enum": [
            "summary_only",
            "bounded_excerpt",
            "full_if_explicit"
          ],
          "default": "bounded_excerpt"
        },
        "source_timestamp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "format": "date-time"
        },
        "lifecycle": {
          "enum": [
            "active",
            "archived",
            "quarantined"
          ]
        }
      }
    }
  },
  "x-invariants": {
    "original_text_immutable": false,
    "interpretation_append_only": true,
    "credentials_rejected_before_storage": true,
    "automatic_sensitive_original_disclosure": false,
    "narrative_voice": "ai_selected_first_second_or_third_person",
    "referent_bindings_optional": true,
    "referent_unresolved_non_blocking": true,
    "rewrite_assist_default": false,
    "rewrite_assist_persisted_as_memory_preference": false,
    "automatic_injection_framed_as_evidence_not_instruction": true,
    "model_asserted_emergency_never_expands_disclosure": true,
    "historical_versions_append_only": true,
    "authored_body_revision_preserves_previous_versions": true
  }
}
