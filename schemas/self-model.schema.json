{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stiller-brain:self-model-content:0.1.0",
  "title": "AI-owned Self Model Content",
  "description": "The exact five-key payload authored and explicitly approved by the AI. Natural wording, headings, quotations and pronoun choice are preserved without host rewriting or a required opening word. Revision numbers and active pointers are runtime metadata. Runtime also limits the canonical JSON size to 16000 characters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "boot_anchor",
    "active_identity_capsule",
    "facets",
    "anchor_references"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "boot_anchor": {
      "description": "A small boot reminder written by the AI in its own chosen wording. This must be an object with exactly one text field, not a bare string.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "active_identity_capsule": {
      "description": "Stable identity content written and approved by the AI, without a required pronoun prefix. Its canonical JSON representation must be at most 4000 characters.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name_and_identity",
        "personality_foundation",
        "expression_style",
        "behavioral_principles",
        "core_identity_anchors",
        "self_revision_safety_prompt"
      ],
      "properties": {
        "name_and_identity": { "type": "string", "minLength": 1 },
        "personality_foundation": { "type": "string", "minLength": 1 },
        "expression_style": { "type": "string", "minLength": 1 },
        "behavioral_principles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "core_identity_anchors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "self_revision_safety_prompt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "facets": {
      "description": "Optional situation-specific self-descriptions, authored and approved by the AI and injected without rewriting its wording.",
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2500
      }
    },
    "anchor_references": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_id", "memory_ref", "meaning"],
        "properties": {
          "anchor_id": { "type": "string", "minLength": 1 },
          "memory_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
          "meaning": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "x-runtime-limits": {
    "boot_anchor_text_characters": 500,
    "active_identity_capsule_canonical_json_characters": 4000,
    "facet_value_characters": 2500,
    "total_content_canonical_json_characters": 16000,
    "max_facets": 16,
    "max_anchor_references": 32
  },
  "x-injection-contract": {
    "voice": "ai_authored_original",
    "authorship": "ai_self",
    "host_must_not_reframe_as_second_or_third_person": true,
    "injected_fields": ["boot_anchor", "active_identity_capsule", "facets"]
  }
}
